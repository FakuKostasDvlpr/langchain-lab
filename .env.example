# Copiá este archivo como `.env` y completá tu clave.
# La clave se saca gratis en https://aistudio.google.com/apikey
# `.env` está en el .gitignore: nunca subas tu clave real al repo.

GOOGLE_API_KEY=tu_api_key_de_google_ai_studio

# Opcional: modelo por defecto de todos los ejercicios.
# IDs validos: gemini-3.5-flash, gemini-3.5-flash-lite, gemini-2.5-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-3.5-flash
